# ─────────────────────────────────────────────────────────────
#  Stamina - Environment Configuration
#  Copy this file to .env and fill in the values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Production domain & SSL ──────────────────────────────────
# Protocol scheme: http (development) or https (production, default).
# SCHEME=http
# Required for Caddy to obtain Let's Encrypt certificates.
# Use a real domain/subdomain, NOT an IP (Let's Encrypt requires a domain).
DOMAIN=stamina.example.com
# Email for Let's Encrypt certificate expiry notifications.
ACME_EMAIL=you@example.com

# ── Public ports (default 80/443) ────────────────────────────
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# ── Supabase (PostgreSQL remoto) ─────────────────────────────
# Supera el bloqueo del host directo (db.<ref>.supabase.co no
# resuelve en algunos entornos) usando el connection pooler.
# Dashboard → Project Settings → Database → Connection pooling.
# TRANSACTION POOLER (recomendado sobre el host directo
# db.<ref>.supabase.co que falla por routing IPv4/IPv6)
SUPABASE_DB_HOST=aws-1-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<PROJECT_REF>
# REQUIRED: Supabase database password
SUPABASE_DB_PASSWORD=change_me

# ── Local PostgreSQL (optional fallback / other services) ───
POSTGRES_DB=stamina
POSTGRES_USER=stamina
# REQUIRED: generate a strong password
POSTGRES_PASSWORD=change_me_strong_password

# ── Trading Core (Python) persistence ────────────────────────
# DATABASE_URL controls where the trading-core persists bot_runs
# and bot_cycles across restarts/redeploys.
#
#   - Empty (default) → SQLite local file (cycles are NOT persisted
#     across container rebuilds)
#   - PostgreSQL URL → Supabase (recommended for production/render)
#
# Example (Supabase transaction pooler — note the %2A URL-encoded
# password and the user prefix <db_user>.<project_ref>):
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASS_URL_ENCODED>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Crypto master key (REQUIRED) ─────────────────────────────
# Used for AES-256 encryption of API keys.
# Generate a secure 32-character (hex) key:
#   openssl rand -hex 32
CRYPTO_MASTER_KEY=change_me_64_hex_chars

# ── eToro API config ─────────────────────────────────────────
ETORO_API_BASE_URL=https://public-api.etoro.com/api/v1
ETORO_API_KEY=replace_me
ETORO_ACCOUNT_ID=replace_me

# ── CORS: allowed browser origins (comma-separated) ─────────
# In production set to your HTTPS domain. Localhost fallback is default.
CORS_ALLOWED_ORIGINS=https://stamina.example.com

# ── Bot API token (optional hardening) ───────────────────────
# If set, the trading-core bot endpoints require this bearer token.
# BOT_API_TOKEN=change_me_bot_token

# ── Frontend build-time vars (relative, proxied by nginx) ────
# These should be RELATIVE paths in production so the JS bundle
# does not expose internal hosts/ports.
# VITE_USERS_CONFIG_API_URL=/api
# VITE_TRADING_CORE_URL=/trading-core